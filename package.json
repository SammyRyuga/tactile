{
  "name": "tactile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.ts --dev",
    "start": "node --env-file-if-exists=.env build/server/index.js",
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.browser.json && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.ts",
    "eval": "node --env-file-if-exists=.env scripts/evaluate.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "express": "5.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "10.8.1",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "7.3.6"
  }
}
