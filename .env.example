# Supabase settings are required for access to the workspace.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
PORT=5173

# Supabase Auth settings. Use a publishable key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
OPENAI_VERIFIER_MODEL=
ALLOWED_HOSTS=
# Optional direct ingress IP ranges (CIDR) for trusted reverse proxies.
TRUSTED_PROXY_RANGES=

# Optional verifier override for signed-in Meta reviews.
META_VERIFIER_MODEL=
